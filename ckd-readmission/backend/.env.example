FLASK_ENV=development
FLASK_DEBUG=True
GROQ_API_KEY=your_groq_api_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
# Required for production JWT verification (found in Supabase Dashboard -> Settings -> API -> JWT Secret)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
# Optional alias for JWT secret
JWT_SECRET=your_supabase_jwt_secret
# Optional CORS origin whitelist (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,https://ckd-risk.vercel.app
